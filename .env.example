# Gemini (free key from aistudio.google.com)
GEMINI_API_KEY=

# Google Calendar (service account route)
GOOGLE_CALENDAR_ID=your-gmail-address@gmail.com
# GOOGLE_SERVICE_ACCOUNT_JSON=   # when deploying: paste the full contents of service_account.json

# Shared secret the iPhone Shortcut sends with each request. Make it long and random:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
API_SECRET=

# Optional
TIMEZONE=Asia/Kolkata
GEMINI_MODEL=gemini-3.5-flash-lite
